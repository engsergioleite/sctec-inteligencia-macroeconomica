# ===== Conexão com o Supabase (Session pooler, porta 5432) =====
# Copie este arquivo para secrets.toml e preencha. O secrets.toml NÃO vai para o GitHub.
[connections.postgresql]
dialect = "postgresql"
driver = "psycopg2"
host = "aws-0-sa-east-1.pooler.supabase.com"
port = "5432"
database = "postgres"
username = "postgres.SEU_PROJECT_REF"
password = "SUA_SENHA_AQUI"
